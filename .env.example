# Public Fourthwall Storefront API token (not an admin/private API credential).
# This token is sent to the browser by the static shop and is expected to be public.
PUBLIC_FOURTHWALL_STOREFRONT_TOKEN=replace-with-public-storefront-token

# Shop host used to send the cart to Fourthwall checkout.
PUBLIC_FOURTHWALL_SHOP_DOMAIN=your-shop.fourthwall.com

# Override only when Fourthwall provides a different API host for your shop.
PUBLIC_FOURTHWALL_STOREFRONT_API_URL=https://storefront-api.fourthwall.com