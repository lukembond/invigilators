---
const articleLetters = "The".split("");
const titleLetters = "Invigilators".split("");
---

<section
  id="landing"
  class="landing-view pointer-events-none relative flex h-screen w-screen items-center justify-center overflow-hidden bg-(--background) opacity-100 transition-opacity duration-260"
>
  <video
    id="video_background"
    autoplay
    loop
    muted
    playsinline
    preload="auto"
    class="landing-video pointer-events-none absolute inset-0 h-full w-full object-cover opacity-[0.72]"
  >
    <source src="/video/invigivideo-1-2009-bg-av1.webm" type='video/webm; codecs="av1"' />
    <source src="/video/invigivideo-1-2009-bg-h265.mp4" type='video/mp4; codecs="hvc1"' />
    <source src="/video/invigivideo-1-2009-bg.mp4" type="video/mp4" />
    <source src="/video/invigivideo-1-2009.mp4" type="video/mp4" />
    <source src="/video/invigivideo-1-2009.webm" type="video/webm" />
  </video>

  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(13,2,5,0.16)_0%,rgba(13,2,5,0.48)_70%,rgba(13,2,5,0.82)_100%)]"
  >
  </div>

  <div
    class="landing-content relative z-1 flex flex-col items-center gap-12 px-6 animate-[fadeInUp_900ms_cubic-bezier(0.16,1,0.3,1)_both] max-[700px]:gap-8"
  >
    <h1
      class="landing-wordmark flex w-[min(94vw,900px)] flex-col items-end leading-none text-(--foreground) max-[700px]:w-[min(86vw,340px)]"
      aria-label="The Invigilators"
    >
      <span
        class="wordmark-line wordmark-line--article block whitespace-nowrap text-[clamp(28px,4vw,52px)] font-light uppercase tracking-(--letter-spacing-base) indent-(--letter-spacing-base) [--letter-spacing-base:0.35em] [--letter-spacing-tight:0.29em] animate-[titleTracking_5200ms_1600ms_ease-in-out_infinite] max-[700px]:text-[clamp(22px,7vw,30px)] max-[700px]:[--letter-spacing-base:0.28em] max-[700px]:[--letter-spacing-tight:0.23em]"
        aria-hidden="true"
      >
        {
          articleLetters.map((letter, index) => (
            <span
              class="wordmark-letter inline-block translate-y-[0.28em] opacity-0 animate-[typeInLetter_420ms_cubic-bezier(0.16,1,0.3,1)_forwards] [animation-delay:calc(180ms+(var(--letter-index)*76ms))]"
              style={`--letter-index: ${index}`}
            >
              {letter}
            </span>
          ))
        }
      </span>
      <strong
        class="wordmark-line wordmark-line--title block whitespace-nowrap text-[clamp(38px,6vw,80px)] font-bold uppercase tracking-(--letter-spacing-base) indent-(--letter-spacing-base) [--letter-spacing-base:0.2em] [--letter-spacing-tight:0.16em] animate-[titleTracking_5200ms_1700ms_ease-in-out_infinite] max-[700px]:text-[clamp(28px,7.5vw,34px)] max-[700px]:[--letter-spacing-base:0.13em] max-[700px]:[--letter-spacing-tight:0.1em]"
        aria-hidden="true"
      >
        {
          titleLetters.map((letter, index) => (
            <span
              class="wordmark-letter inline-block translate-y-[0.28em] opacity-0 animate-[typeInLetter_420ms_cubic-bezier(0.16,1,0.3,1)_forwards] [animation-delay:calc(180ms+(var(--letter-index)*76ms))]"
              style={`--letter-index: ${index + articleLetters.length + 1}`}
            >
              {letter}
            </span>
          ))
        }
      </strong>
    </h1>
    <div class="landing-rule h-px w-30 origin-center bg-(--primary)" aria-hidden="true"></div>
    <button
      id="enter-btn"
      class="enter-btn pointer-events-auto relative z-2 isolate cursor-pointer overflow-hidden border border-[rgba(240,228,228,0.35)] bg-transparent px-10 py-3.5 text-[11px] font-normal uppercase tracking-[0.3em] text-(--foreground) indent-[0.3em] transition-[border-color,background,box-shadow] duration-300 hover:border-[rgba(140,10,23,0.9)] hover:bg-[rgba(140,10,23,0.12)] hover:shadow-[0_0_26px_rgba(196,17,42,0.22),0_0_0_1px_rgba(196,17,42,0.22)_inset] hover:outline-none focus-visible:border-[rgba(140,10,23,0.9)] focus-visible:bg-[rgba(140,10,23,0.12)] focus-visible:shadow-[0_0_26px_rgba(196,17,42,0.22),0_0_0_1px_rgba(196,17,42,0.22)_inset] focus-visible:outline-none"
      type="button">Open Booklet</button
    >
  </div>

  <div
    class="corner-accent corner-accent--top pointer-events-none absolute left-8 top-8 size-12 border-l border-t border-[rgba(140,10,23,0.5)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="corner-accent corner-accent--bottom pointer-events-none absolute bottom-8 right-8 size-12 border-b border-r border-[rgba(140,10,23,0.5)]"
    aria-hidden="true"
  >
  </div>
</section>
