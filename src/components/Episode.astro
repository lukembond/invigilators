---
interface Props {
  id: string;
  type: string;
  title: string;
  length: string;
  image_cover?: string;
  image_bg?: string;
  index: number;
}

const { id, type, title, length, image_cover, image_bg, index } = Astro.props;

const tileImage = image_cover || image_bg || "/img/episode-bg/ahNotFound.png";
const fallbackImage = image_bg || "/img/episode-bg/ahNotFound.png";
const typeLabel = type === "mykonos" ? "Mykonos Sessions" : "Aural Homework";
---

<a
  href={`/episodes/${id}`}
  class="album-tile group relative block aspect-square w-full origin-center cursor-pointer overflow-hidden border-0 bg-black p-0 text-(--foreground) transition-[transform,box-shadow] duration-320 ease-[cubic-bezier(0.22,1,0.36,1)] transform-gpu will-change-transform backface-hidden hover:z-5 hover:scale-[1.08] hover:shadow-[0_16px_40px_rgba(0,0,0,0.5),0_0_0_1px_rgba(240,228,228,0.22)] focus-visible:z-4 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[rgba(255,255,255,0.86)] hover:focus-visible:z-5"
  data-id={id}
  data-index={index}
  data-type={type}
  aria-label={`Open ${title}`}
>
  <img
    class="block h-full w-full object-cover transition-filter duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:brightness-[0.9] group-focus-visible:brightness-[0.9]"
    src={tileImage}
    data-fallback-src={fallbackImage}
    alt={title}
    loading={index < 12 ? "eager" : "lazy"}
    decoding="async"
  />
  <span
    class="album-tile-overlay absolute inset-0 flex flex-col justify-end bg-linear-to-t from-[rgba(13,2,5,0.76)] via-[rgba(13,2,5,0.28)] to-transparent p-2.5 text-left opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
    aria-hidden="true"
  >
    <span
      class="album-tile-genre mb-0.75 overflow-hidden text-ellipsis whitespace-nowrap text-[9px] font-semibold uppercase tracking-[0.15em] text-(--accent)"
      >{typeLabel}</span
    >
    <strong
      class="overflow-hidden text-[10px] font-semibold leading-[1.3] text-(--foreground) [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2]"
      >{title}</strong
    >
    <em class="mt-1.25 font-mono text-[8px] not-italic tracking-[0.06em] text-(--muted-foreground)"
      >{length}</em
    >
  </span>
  <span
    class="album-tile-border pointer-events-none absolute inset-0 border border-[rgba(240,228,228,0)] transition-colors duration-120 group-hover:border-[rgba(240,228,228,0.38)] group-focus-visible:border-[rgba(240,228,228,0.38)]"
    aria-hidden="true"></span>
</a>
